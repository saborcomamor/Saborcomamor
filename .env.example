# Número verificado do WhatsApp comercial, no formato 5542999999999.
# O botão não envia sem esta configuração.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Endereço definitivo quando houver domínio. Não informe URL inventada.
NEXT_PUBLIC_SITE_URL=

# Supabase: URL e chave publicável (NÃO são credenciais de administrador).
# Nunca usar service_role ou secret key com NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
